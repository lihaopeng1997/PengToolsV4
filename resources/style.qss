/* PengTools V4.27 · Quiet aesthetics + theme tokens
 * Placeholders injected by ui/theme_manager.py
 * Themes: calm (default) | clear | warm | black（night 兼容别名）
 * Tokens: __APP_BG__ __SIDEBAR_BG__ __SURFACE__ __PRIMARY__ __TEXT__ ...
 */
/*
 * Tokens (Qt QSS has no CSS vars — locked values, Python: ui/layout_metrics.py)
 * app-bg __APP_BG__ | sidebar-bg __SIDEBAR_BG__ | surface __SURFACE__ | surface-soft __SURFACE_SOFT__
 * text-strong __TEXT_STRONG__ | text __TEXT__ | text-muted __TEXT_MUTED__ | nav-text __TEXT_NAV__
 * border __BORDER__ | primary __PRIMARY__ | primary-soft __PRIMARY_SOFT__ | primary-active __PRIMARY_ACTIVE__
 * cyan __CYAN__ | success __SUCCESS__ | warning __WARNING__ | danger __DANGER__
 * radius-control 8 | radius-card 12 | radius-dialog 16 | control-h 28
 */
QWidget {
    color: __TEXT__;
    background-color: __APP_BG__;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-size: 13px;
}
QMainWindow {
    background: __APP_BG__;
}
QFrame#content_area, QStackedWidget {
    background: __APP_BG__;
}
QStackedWidget > QWidget {
    background: __APP_BG__;
}
QScrollArea {
    background: __APP_BG__;
    border: none;
}
QScrollArea > QWidget,
QScrollArea::viewport {
    background: __APP_BG__;
}
QStatusBar {
    background: __STATUS_BAR_BG__;
    color: __TEXT_MUTED__;
    border-top: 1px solid __BORDER__;
}
QTableCornerButton::section {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
}
QSpinBox, QDoubleSpinBox {
    background: __SURFACE__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 2px 8px;
}
QLabel, QCheckBox, QRadioButton { background: transparent; }
QCheckBox {
    spacing: 8px;
    color: __TEXT__;
    padding: 2px 0;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid __BORDER_STRONG__;
    background: __SURFACE__;
}
QCheckBox::indicator:hover {
    border-color: __PRIMARY__;
}
QCheckBox::indicator:checked {
    border-color: __PRIMARY__;
    background: __PRIMARY__;
    image: url("__CHECKMARK__");
}
QCheckBox::indicator:checked:hover {
    border-color: __PRIMARY_HOVER__;
    background: __PRIMARY_HOVER__;
    image: url("__CHECKMARK__");
}
QFrame#flag-check-card {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QCheckBox#flag-check {
    padding: 8px 10px;
    border-radius: 10px;
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    min-height: 20px;
    font-weight: 600;
    color: __TEXT__;
}
QCheckBox#flag-check:hover {
    border-color: __BORDER_STRONG__;
    background: __SURFACE__;
}
QCheckBox#flag-check:checked {
    border-color: __BORDER_STRONG__;
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
}
QCheckBox#flag-check::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
}
/* —— Astra 浅色导航 —— */
#sidebar {
    background: __SIDEBAR_BG__;
    border-right: 1px solid __SIDEBAR_BORDER__;
}
#sidebar-brand {
    background: transparent;
    border: none;
    border-radius: 10px;
    min-height: 52px;
}
#sidebar-brand-icon {
    background: __PRIMARY_SOFT__;
    border-radius: 10px;
    border: 1px solid __PRIMARY_SOFT__;
}
#sidebar_title {
    color: __TEXT_STRONG__;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.2px;
}
#sidebar_version {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.4px;
}
#sidebar-section {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.2px;
    padding: 14px 12px 6px 12px;
}
#sidebar-sep {
    background: __SIDEBAR_BORDER__;
    border: none;
    max-height: 1px;
    margin: 6px 2px 4px 2px;
}
#sidebar-collapse-btn {
    background: __PRIMARY_SOFT__;
    border: 1px solid __BORDER_STRONG__;
    border-radius: 8px;
    color: __PRIMARY_ACTIVE__;
    padding: 0px;
}
#sidebar-collapse-btn:hover {
    color: __PRIMARY_ACTIVE__;
    background: __TABLE_SELECT__;
    border-color: __PRIMARY__;
}
#sidebar-scroll, #sidebar-nav-host {
    background: transparent;
    border: none;
}
#sidebar #author-label { color: __TEXT_MUTED__; font-size: 11px; }
#sidebar #small-label { color: __TEXT_MUTED__; }
#user-chip {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 16px;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
}
#user-chip:hover {
    background: __PRIMARY_SOFT__;
}

QLabel#docx-template-status {
    color: __WARNING__;
    background: __SURFACE_SOFT__;
    border: 1px solid __WARNING__;
    border-radius: 10px;
    padding: 8px 10px;
}
QLabel#docx-template-status[matched="true"] {
    color: __SUCCESS__;
    background: __PRIMARY_SOFT__;
    border-color: __SUCCESS__;
}
#small-label { color: __TEXT__; font-size: 12px; }
#author-label { color: __PRIMARY__; font-size: 12px; font-weight: 700; padding: 4px 2px; }
#field-hint { color: __TEXT__; font-size: 12px; background: transparent; }
#path-note {
    color: __TEXT__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 10px;
    padding: 7px 10px;
    line-height: 1.35;
    font-size: 12px;
}
#section-title { color: __TEXT_MUTED__; font-size: 11px; font-weight: 650; letter-spacing: 0.6px; }
QLabel#flow-steps {
    color: __TEXT_MUTED__;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
    padding: 2px 2px 6px 2px;
}
#hotkey-pill {
    color: __PRIMARY_ACTIVE__; background: __PRIMARY_SOFT__; border: 1px solid __PRIMARY_SOFT__;
    border-radius: 12px; padding: 8px;
}
QLabel#requirement-flags {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 10px;
    padding: 8px 10px;
}
QLabel#svn-workspace-meta {
    color: __TEXT_MUTED__;
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
    max-height: 28px;
}
/* —— Button system —— */
QPushButton {
    background: __SURFACE__; color: __TEXT__; border: 1px solid __BORDER__;
    border-radius: 8px; padding: 6px 12px;
    font-weight: 500;
    min-height: 20px;
}
QPushButton:hover { background: __PRIMARY_SOFT__; border-color: __PRIMARY__; color: __PRIMARY_ACTIVE__; }
QPushButton:pressed { background: __PRIMARY_SOFT__; border-color: __PRIMARY__; color: __TEXT__; }
QPushButton:disabled { color: __DISABLED_TEXT__; background: __DISABLED_BG__; border-color: __BORDER__; }
QPushButton#btn-secondary {
    background: __SURFACE__; color: __TEXT__; border: 1px solid __BORDER__;
    border-radius: 8px; font-weight: 500;
}
QPushButton#btn-secondary:hover { background: __PRIMARY_SOFT__; border-color: __PRIMARY__; color: __PRIMARY_ACTIVE__; }
QPushButton#btn-secondary:pressed { background: __PRIMARY_SOFT__; border-color: __PRIMARY__; }
QPushButton#primary-btn:pressed, QPushButton#card-action:pressed {
    background: __PRIMARY_HOVER__;
    color: __ON_PRIMARY__;
}
QPushButton#primary-btn, QPushButton#card-action {
    background: __PRIMARY__;
    color: __ON_PRIMARY__; border: none; font-weight: 600; padding: 7px 14px;
    border-radius: 8px;
}
QPushButton#primary-btn:hover, QPushButton#card-action:hover {
    background: __PRIMARY_HOVER__;
    color: __ON_PRIMARY__;
}
QPushButton#primary-btn:disabled, QPushButton#card-action:disabled {
    background: __DISABLED_BG__; color: __PRIMARY_SOFT__; border: none;
}
/* danger：统一破坏性操作（兼容历史 ops-delete-custom） */
QPushButton#btn-danger, QPushButton#ops-delete-custom {
    color: __DANGER__;
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    font-weight: 700;
}
QPushButton#btn-danger:hover, QPushButton#ops-delete-custom:hover {
    background: __SURFACE_SOFT__;
    border-color: __DANGER__;
    color: __DANGER__;
}
QPushButton#btn-danger:pressed, QPushButton#ops-delete-custom:pressed {
    background: __SURFACE_SOFT__;
    border-color: __DANGER__;
}
/* ghost：次级工具按钮（浅底+边框）；#ghost-btn 为历史别名，样式与 #btn-ghost 一致 */
QPushButton#btn-ghost,
QPushButton#ghost-btn {
    background: __SURFACE_SOFT__;
    color: __TEXT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    font-weight: 600;
}
QPushButton#btn-ghost:hover,
QPushButton#ghost-btn:hover {
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY__;
    color: __PRIMARY_ACTIVE__;
}
QPushButton#btn-ghost:pressed,
QPushButton#ghost-btn:pressed {
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY__;
}
QPushButton#btn-ghost:disabled,
QPushButton#ghost-btn:disabled {
    background: __DISABLED_BG__;
    color: __DISABLED_TEXT__;
    border-color: transparent;
}
/* 紧凑行内按钮：与 field_metrics.BTN_COMPACT_H=28 对齐 */
QPushButton[compactAction="true"] {
    padding: 3px 10px;
    min-height: 28px;
    max-height: 28px;
    font-size: 12px;
    border-radius: 8px;
}
QPushButton#fold-action-btn {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
    border: 1px solid __BORDER_STRONG__;
    border-radius: 8px;
    font-weight: 700;
    padding: 3px 10px;
}
QPushButton#fold-action-btn:hover {
    background: __TABLE_SELECT__;
    border-color: __PRIMARY__;
    color: __PRIMARY_ACTIVE__;
}
QPushButton#fold-action-btn:pressed {
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY__;
}
/* 浅色导航项 */
QPushButton#nav-btn, QPushButton#nav-btn-settings {
    background: transparent;
    color: __TEXT_NAV__;
    border: none;
    border-radius: 10px;
    padding: 10px 12px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    min-height: 22px;
    border-left: 3px solid transparent;
}
QPushButton#nav-btn:hover, QPushButton#nav-btn-settings:hover {
    background: __NAV_HOVER__;
    color: __TEXT_STRONG__;
}
QPushButton#nav-btn:checked, QPushButton#nav-btn-settings:checked {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
    font-weight: 600;
    border-left: 3px solid __PRIMARY__;
}
QPushButton#nav-btn-settings {
    padding-top: 10px;
    padding-bottom: 10px;
}
QPushButton#nav-btn[iconOnly="true"], QPushButton#nav-btn-settings[iconOnly="true"] {
    padding: 10px 8px;
    text-align: center;
    min-width: 48px;
}
/* 页面骨架 */
QFrame#page-header {
    background: transparent;
    border: none;
    min-height: 60px;
}
QLabel#page-header-icon {
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 10px;
}
QFrame#page-filter-bar {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
/* 页面骨架 L2 工具栏（规范 v1 §4）：批量操作按钮组容器；
 * 默认透明；divided="true" 时加底部分隔线用于与内容区强分层 */
QFrame#page-toolbar {
    background: transparent;
    border: none;
}
QFrame#page-toolbar[divided="true"] {
    border-bottom: 1px solid __BORDER__;
}
/* 页面骨架 L4 空状态（规范 v1 §6.3）：图标 + 标题 + 引导 + 可选按钮 */
QFrame#empty-state {
    background: __SURFACE__;
    border: 1px dashed __BORDER_STRONG__;
    border-radius: 12px;
}
QLabel#empty-state-icon {
    background: transparent;
    color: __TEXT_MUTED__;
}
QLabel#empty-state-title {
    background: transparent;
    color: __TEXT_STRONG__;
    font-size: 14px;
    font-weight: 600;
}
QLabel#empty-state-text {
    background: transparent;
    color: __TEXT_MUTED__;
    font-size: 12px;
}
QFrame#chat-risk-banner {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-left: 3px solid __WARNING__;
    border-radius: 10px;
}
QFrame#chat-bubble-user, QFrame#chat-bubble-assistant {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QFrame#chat-bubble-user {
    background: __PRIMARY_SOFT__;
}
QTextEdit#ai-explain {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
/* 分区标题：左边线色块区分模块 */
QLabel#zone-title {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 1px 0 2px 10px;
    border-left: 2px solid __PRIMARY__;
    background: transparent;
}
QLabel#zone-title-inline {
    color: __SUCCESS__;
    font-size: 12px;
    font-weight: 800;
    padding: 2px 10px 2px 10px;
    min-width: 40px;
    border-left: 3px solid __SUCCESS__;
    background: transparent;
}
QFrame#req-tree-card QLabel#zone-title { border-left-color: __PRIMARY__; color: __PRIMARY_ACTIVE__; }
QFrame#req-file-card QLabel#zone-title { border-left-color: __TEXT_MUTED__; color: __TEXT_STRONG__; }
QFrame#req-sql-card QLabel#zone-title { border-left-color: __SUCCESS__; color: __SUCCESS__; }
QFrame#detail-summary-card QLabel#zone-title { border-left-color: __PRIMARY__; }
QFrame#release-filter-zone QLabel#zone-title { border-left-color: __PRIMARY__; color: __PRIMARY_ACTIVE__; }
QFrame#release-table-zone QLabel#zone-title { border-left-color: __TEXT_MUTED__; color: __TEXT_STRONG__; }
QFrame#release-generate-zone QLabel#zone-title-inline { border-left-color: __SUCCESS__; color: __SUCCESS__; }
/* —— 输入 / 下拉 / 多行：统一高度、圆角、焦点环 —— */
QComboBox, QLineEdit, QDateEdit, QTimeEdit {
    background: __SURFACE__; color: __TEXT_STRONG__; border: 1px solid __BORDER__;
    border-radius: 10px; padding: 4px 10px; selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
    min-height: 18px;
    max-height: 28px;
}
QTextEdit, QPlainTextEdit {
    background: __SURFACE__; color: __TEXT_STRONG__; border: 1px solid __BORDER__;
    border-radius: 10px; padding: 7px 10px; selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
}
QComboBox { padding-right: 38px; }
QDateEdit, QTimeEdit { min-width: 150px; max-width: 160px; padding-right: 36px; }
QComboBox:hover, QLineEdit:hover, QDateEdit:hover, QTimeEdit:hover { border-color: __PRIMARY__; background: __SURFACE__; }
QComboBox:focus, QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: __PRIMARY__;
    background: __SURFACE__;
}
QComboBox:disabled, QLineEdit:disabled, QDateEdit:disabled, QTimeEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: __TEXT_MUTED__;
    background: __SURFACE_SOFT__;
    border-color: __BORDER__;
}
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: top right;
    width: 32px; border: none; border-left: 1px solid __BORDER__;
    background: __PRIMARY_SOFT__; border-top-right-radius: 8px; border-bottom-right-radius: 8px;
}
QComboBox::drop-down:hover { background: __PRIMARY_SOFT__; }
QComboBox::down-arrow { image: url("__DROPDOWN_ARROW__"); width: 11px; height: 11px; }
QComboBox QAbstractItemView {
    background: __SURFACE__; color: __TEXT_STRONG__; border: 1px solid __BORDER__;
    border-radius: 8px; padding: 5px; outline: 0;
    selection-background-color: __PRIMARY__; selection-color: __ON_PRIMARY__;
}
QComboBox QLineEdit {
    background: __SURFACE__;
    color: __TEXT_STRONG__;
    border: none;
    padding: 0 4px;
    min-height: 16px;
    max-height: 24px;
}
QTabWidget#module-tabs {
    background: transparent;
}
QFrame#credit-filter-card,
QWidget#credit-tab {
    background: __SURFACE__;
}
QFrame#credit-filter-card {
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
/* 设计系统表面 */
QFrame#ds-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QFrame#ds-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-left: 3px solid __PRIMARY__;
    border-radius: 12px;
}
QFrame#ds-muted {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
/* Gateway 加解密工作台 */
QGroupBox#gateway-config-group {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 700;
    color: __TEXT_STRONG__;
}
QGroupBox#gateway-config-group::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: __PRIMARY_ACTIVE__;
}
QFrame#gateway-work-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QGroupBox#vin-settings,
QGroupBox#docx-file-group {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    margin-top: 4px;
    padding-top: 8px;
    font-weight: 650;
    color: __TEXT_MUTED__;
}
QGroupBox#vin-settings::title,
QGroupBox#docx-file-group::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: __TEXT_MUTED__;
}
QFrame#gateway-action-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QLineEdit#compact-step-value {
    min-width: 48px;
    max-width: 64px;
    min-height: 18px;
    max-height: 28px;
    padding: 2px 4px;
}
QFrame#gateway-work-zone QLabel#zone-title {
    border-left-color: __TEXT_MUTED__;
    color: __TEXT_STRONG__;
}
QPlainTextEdit#gateway-key-edit,
QPlainTextEdit#gateway-cipher-edit {
    background: __INPUT_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
}
QPlainTextEdit#gateway-key-edit:focus,
QPlainTextEdit#gateway-cipher-edit:focus {
    border-color: __PRIMARY__;
    background: __SURFACE__;
    color: __TEXT_STRONG__;
}
/* xml-splitter 已由全局 QSplitter::handle 统一管理 */
/* XML 工具工作区 */
QFrame#xml-workspace-header {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-left: 3px solid __PRIMARY__;
    border-radius: 12px;
}
QFrame#xml-workspace-header QLabel#zone-title {
    border-left-color: __PRIMARY__;
}
QFrame#xml-toolbar {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QFrame#xml-work-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    border-top: 2px solid __PRIMARY__;
}
QPlainTextEdit#xml-input,
QPlainTextEdit#xml-output {
    background: __INPUT_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
}
QPlainTextEdit#xml-input:focus,
QPlainTextEdit#xml-output:focus {
    border-color: __PRIMARY__;
    background: __SURFACE__;
    color: __TEXT_STRONG__;
}
QPlainTextEdit#xml-output {
    background: __SURFACE__;
    color: __TEXT_STRONG__;
}
QCheckBox#xml-wrap-check {
    color: __TEXT__;
    font-weight: 600;
    spacing: 6px;
    padding: 2px 4px;
}
QLabel[xmlStatus="error"] {
    color: __DANGER__;
    font-weight: 650;
}
QLabel[xmlStatus="ok"] {
    color: __SUCCESS__;
    font-weight: 650;
}

/* 全局分割线：细线风格，仅 hover 时高亮 */
QSplitter::handle:horizontal {
    width: 6px;
    margin: 0;
    background: __BORDER__;
    border: none;
    border-radius: 0;
}
QSplitter::handle:horizontal:hover {
    background: __PRIMARY_SOFT__;
}
QSplitter#requirement-splitter::handle:horizontal {
    width: 8px;
    margin: 0;
    background: __BORDER__;
    border: none;
}
QSplitter::handle:vertical {
    height: 6px;
    margin: 0;
    background: __BORDER__;
    border: none;
    border-radius: 0;
}
QSplitter::handle:vertical:hover {
    background: __PRIMARY_SOFT__;
}
/* 需求摘要紧凑卡：内容定高，文件库占满剩余（无垂直把手） */
QTreeWidget#requirement-tree {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    outline: 0;
    show-decoration-selected: 1;
    padding: 4px 3px;
}
QTreeWidget#requirement-tree::item {
    min-height: 32px;
    padding: 5px 8px 5px 6px;
    color: __TEXT_STRONG__;
    border-bottom: 1px solid __BORDER__;
    border-radius: 6px;
    margin: 1px 2px;
}
/* 分组节点：企业级台账 / 网盘文件夹感 */
QTreeWidget#requirement-tree::item:has-children {
    min-height: 30px;
    padding: 7px 10px 7px 6px;
    background: __MONTH_HEADER_BG__;
    color: __MONTH_HEADER_FG__;
    font-size: 12px;
    font-weight: 800;
    border-bottom: 1px solid __BORDER_STRONG__;
    border-radius: 6px;
    margin: 2px 2px;
}
QTreeWidget#requirement-tree::item:hover { background: __PRIMARY_SOFT__; color: __TEXT_STRONG__; }
QTreeWidget#requirement-tree::item:has-children:hover {
    background: __PRIMARY_SOFT__;
    color: __TEXT_STRONG__;
}
/* 选中：主题软底 + 主色字 + 左侧强调，避免晴空/系统蓝块 */
QTreeWidget#requirement-tree::item:selected,
QTreeWidget#requirement-tree::item:selected:active,
QTreeWidget#requirement-tree::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 3px solid __PRIMARY__;
    font-weight: 700;
}
QTreeWidget#requirement-tree::item:has-children:selected,
QTreeWidget#requirement-tree::item:has-children:selected:active,
QTreeWidget#requirement-tree::item:has-children:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 3px solid __PRIMARY__;
}
QTreeWidget#requirement-tree::branch { background: transparent; }
QTreeWidget#requirement-tree::branch:hover { background: transparent; }
QTreeWidget#requirement-tree::branch:selected { background: transparent; }

/* 需求管理分区卡片：工具 / 筛选 / 左树 / 文件 / SQL 分层 */
QFrame#req-toolbar-card,
QFrame#req-filter-card,
QFrame#req-tree-card,
QFrame#req-file-card,
QFrame#req-sql-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QFrame#req-toolbar-card {
    background: __SURFACE__;
    border-left: 3px solid __PRIMARY__;
}
/* 需求顶栏：主流程（扫描/检出/更新/新建）与次流程（缺陷/导入/配置） */
QFrame#req-toolbar-primary {
    background: __PRIMARY_SOFT__;
    border: 1px solid __BORDER_STRONG__;
    border-left: 3px solid __PRIMARY__;
    border-radius: 10px;
}
QFrame#req-toolbar-secondary {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QFrame#req-toolbar-secondary QPushButton {
    color: __TEXT__;
    background: __SURFACE__;
}
QFrame#req-toolbar-secondary QPushButton:hover {
    color: __PRIMARY_ACTIVE__;
    border-color: __PRIMARY__;
    background: __PRIMARY_SOFT__;
}
QFrame#req-filter-card {
    background: __SURFACE_SOFT__;
    border-style: solid;
}
QFrame#req-tree-card {
    background: __SURFACE__;
    border-left: 3px solid __PRIMARY__;
}
QFrame#req-file-card {
    background: __SURFACE__;
    border-top: 2px solid __TEXT_MUTED__;
}
QFrame#req-sql-card {
    background: __SURFACE_SOFT__;
    border-left: 3px solid __SUCCESS__;
}
QListWidget#docx-doc-list {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 4px;
}
QListWidget#docx-doc-list::item {
    min-height: 28px;
    padding: 5px 8px;
    border-radius: 6px;
}
QListWidget#docx-doc-list::item:selected,
QListWidget#docx-doc-list::item:selected:active,
QListWidget#docx-doc-list::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 3px solid __PRIMARY__;
}
QTreeWidget#docx-output-browser {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    alternate-background-color: __SURFACE_SOFT__;
}
QTreeWidget#docx-output-browser::item {
    min-height: 26px;
    padding: 3px 4px 3px 2px;
}
QTreeWidget#docx-output-browser QHeaderView::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
QTreeWidget#ops-export-tree {
    border: 1px solid __BORDER__;
    border-radius: 8px;
    background: __SURFACE__;
    alternate-background-color: __TABLE_ALT__;
    color: __TEXT_STRONG__;
    outline: 0;
    show-decoration-selected: 0;
}
QTreeWidget#ops-export-tree::item {
    min-height: 28px;
    padding: 4px 6px;
    color: __TEXT_STRONG__;
}
QTreeWidget#ops-export-tree::item:hover { background: __PRIMARY_SOFT__; color: __TEXT_STRONG__; }
QTreeWidget#ops-export-tree::item:selected,
QTreeWidget#ops-export-tree::item:selected:active,
QTreeWidget#ops-export-tree::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
}
QTreeWidget#ops-export-tree QHeaderView::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
QTreeWidget#requirement-file-tree,
QTreeWidget#ops-remote-tree {
    border: 1px solid __BORDER__;
    border-radius: 8px;
    background: __SURFACE__;
    alternate-background-color: __TABLE_ALT__;
    color: __TEXT_STRONG__;
    outline: 0;
    /* 0：图标装饰只出现在名称列，避免选中时其它列也像“带图标” */
    show-decoration-selected: 0;
}
QTreeWidget#requirement-file-tree::item {
    min-height: 22px;
    padding: 1px 6px;
    border: none;
    border-bottom: 1px solid __BORDER__;
    color: __TEXT_STRONG__;
}
QTreeWidget#ops-remote-tree::item {
    min-height: 30px;
    padding: 5px 8px;
    border: none;
    border-bottom: 1px solid __BORDER__;
    color: __TEXT_STRONG__;
}
QTreeWidget#requirement-file-tree::item:hover,
QTreeWidget#ops-remote-tree::item:hover { background: __PRIMARY_SOFT__; color: __TEXT_STRONG__; }
QTreeWidget#requirement-file-tree::item:selected,
QTreeWidget#requirement-file-tree::item:selected:active,
QTreeWidget#requirement-file-tree::item:selected:!active,
QTreeWidget#ops-remote-tree::item:selected,
QTreeWidget#ops-remote-tree::item:selected:active,
QTreeWidget#ops-remote-tree::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 2px solid __PRIMARY__;
}
QTreeWidget#requirement-file-tree::branch,
QTreeWidget#ops-remote-tree::branch { background: transparent; }
QTreeWidget#requirement-file-tree::branch:hover,
QTreeWidget#ops-remote-tree::branch:hover { background: transparent; }
QTreeWidget#requirement-file-tree::branch:selected,
QTreeWidget#ops-remote-tree::branch:selected { background: transparent; }
/* 表头与全局统一（保留选择器供模块定向测试） */
QTreeWidget#requirement-file-tree QHeaderView::section,
QTreeWidget#ops-remote-tree QHeaderView::section,
QHeaderView#requirement-file-header::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
QTreeWidget#requirement-file-tree QHeaderView::section:hover,
QTreeWidget#ops-remote-tree QHeaderView::section:hover,
QHeaderView#requirement-file-header::section:hover { background: __PRIMARY_SOFT__; }
QTreeWidget#requirement-file-tree QHeaderView::section:last,
QTreeWidget#ops-remote-tree QHeaderView::section:last,
QHeaderView#requirement-file-header::section:last { border-right: none; }
QFrame#detail-action-card {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QFrame#ops-list-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QFrame#detail-summary-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-left: 3px solid __PRIMARY__;
    border-radius: 12px;
}
QLabel#detail-tags {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 8px;
    padding: 4px 8px;
    font-weight: 650;
    font-size: 12px;
}
QFrame#detail-summary-card QLabel#field-caption {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 650;
    min-width: 0;
    max-width: 16777215;
}
QFrame#detail-summary-card QLabel#field-value {
    color: __TEXT_STRONG__;
    background: __SIDEBAR_BG__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 16px;
    font-weight: 650;
}
QLabel#field-value {
    color: __TEXT__;
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 6px 8px;
    min-height: 16px;
}
QLabel#detail-desc {
    color: __TEXT__;
    background: __SURFACE_SOFT__;
    border: 1px dashed __BORDER__;
    border-radius: 10px;
    padding: 8px 10px;
}
QWidget#flag-section {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}
QWidget#flag-chips-host {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}
QPushButton#flag-chip {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 5px 8px 6px 8px; /* 下边略多，边框完整不裁切 */
    font-weight: 600;
    font-size: 12px;
    min-height: 30px;
    max-height: 34px;
    min-width: 72px;
    text-align: left;
}
QPushButton#flag-chip[flagDone="true"] {
    background: __PRIMARY_SOFT__;
    color: __SUCCESS__;
    border: 1px solid __SUCCESS__;
}
QPushButton#flag-chip[flagDone="false"] {
    background: __SURFACE_SOFT__;
    color: __WARNING__;
    border: 1px solid __BORDER_STRONG__;
}
QPushButton#flag-chip:hover {
    border-color: __PRIMARY__;
}
QPushButton#flag-chip:pressed {
    padding-top: 6px;
    padding-bottom: 5px;
}
QLabel#flag-section-caption {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 0;
}
QLineEdit#date-input-edit {
    min-width: 128px;
    max-width: 160px;
    min-height: 18px;
    max-height: 28px;
    padding: 4px 10px;
}
/* 日期统一：yyyy-MM-dd 150–160；月份略窄 */
QDateEdit {
    min-width: 150px;
    max-width: 160px;
    min-height: 18px;
    max-height: 28px;
}
QLabel#field-caption {
    color: __TEXT__;
    font-weight: 700;
    background: transparent;
    min-width: 80px;
    max-width: 80px;
    min-height: 28px;
}
QFrame#release-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
/* 升级准备：顶筛选 / 中表格 / 底生成 — 三区色相对比 */
QFrame#release-filter-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QFrame#release-table-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER_STRONG__;
    border-radius: 12px;
    border-top: 2px solid __TEXT_MUTED__;
}
QFrame#release-generate-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-left: 3px solid __PRIMARY__;
    border-radius: 12px;
}
/* SQL 整理：工具 / 交付 / 编辑 / 动作 — 与升级准备同级分区语言 */
QFrame#sql-tool-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QFrame#sql-delivery-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QFrame#sql-editor-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER_STRONG__;
    border-radius: 12px;
    border-top: 2px solid __TEXT_MUTED__;
}
QFrame#sql-action-zone {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-left: 3px solid __PRIMARY__;
    border-radius: 12px;
}
QFrame#sql-tool-zone QLabel#zone-title { border-left-color: __PRIMARY__; color: __PRIMARY_ACTIVE__; }
QFrame#sql-delivery-zone QLabel#zone-title { border-left-color: __PRIMARY__; color: __PRIMARY_ACTIVE__; }
QFrame#sql-editor-zone QLabel#zone-title { border-left-color: __TEXT_MUTED__; color: __TEXT_STRONG__; }
QFrame#sql-action-zone QLabel#zone-title-inline { border-left-color: __SUCCESS__; color: __SUCCESS__; }
QPlainTextEdit#sql-input-editor,
QPlainTextEdit#sql-format-editor,
QPlainTextEdit#text-helper-input,
QPlainTextEdit#text-helper-output,
QPlainTextEdit#iface-detail-edit,
QPlainTextEdit#iface-draft-preview {
    background: __INPUT_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
}
QPlainTextEdit#sql-input-editor:focus,
QPlainTextEdit#sql-format-editor:focus,
QPlainTextEdit#text-helper-input:focus,
QPlainTextEdit#text-helper-output:focus,
QPlainTextEdit#iface-detail-edit:focus,
QPlainTextEdit#iface-draft-preview:focus {
    border-color: __PRIMARY__;
    background: __SURFACE__;
    color: __TEXT_STRONG__;
}
QTableWidget#iface-request-table {
    background: __SURFACE__;
    alternate-background-color: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    gridline-color: __BORDER__;
    selection-background-color: __TABLE_SELECT__;
    selection-color: __PRIMARY_ACTIVE__;
}
QTableWidget#iface-request-table::item {
    padding: 4px 6px;
    color: __TEXT_STRONG__;
}
QTableWidget#iface-request-table::item:selected,
QTableWidget#iface-request-table::item:selected:active,
QTableWidget#iface-request-table::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
}
QFrame#iface-conn-zone,
QFrame#iface-draft-zone,
QFrame#iface-session-pane,
QFrame#iface-detail-workspace {
    border: 1px solid __BORDER__;
    border-radius: 12px;
    background: __SURFACE__;
}
QFrame#iface-session-toolbar {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 2px 0 4px;
}
QScrollArea#iface-session-toolbar-scroll {
    background: transparent;
    border: none;
}
QLineEdit#iface-session-search {
    min-height: 28px;
    max-height: 32px;
    padding: 4px 10px;
    border: 1px solid __BORDER__;
    background: __INPUT_BG__;
    color: __TEXT_STRONG__;
}
QLineEdit#iface-session-search:focus {
    border: 1px solid __FOCUS_RING__;
}
/* sql-editor-splitter 已由全局 QSplitter::handle 统一管理 */
QLineEdit#release-readonly {
    background: __SIDEBAR_BG__;
    color: __TEXT__;
    min-width: 200px;
}
QDateEdit#release-date, QDateEdit#docx-date {
    min-width: 150px;
    max-width: 160px;
    min-height: 18px;
    max-height: 34px;
    padding: 7px 38px 7px 11px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.3px;
}
QDateEdit#release-date:focus, QDateEdit#docx-date:focus {
    padding: 6px 37px 6px 10px;
}
QLabel#release-status {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 8px;
    padding: 7px 10px;
    font-weight: 700;
}
/* 状态胶囊：按文案收缩，避免「就绪」被拉成一条长条 */
QLabel#status-pill {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
    min-height: 18px;
    max-height: 28px;
    max-width: 200px;
}
QLabel#system-chip {
    color: __SUCCESS__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __SUCCESS__;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
    min-height: 18px;
    max-height: 28px;
    max-width: 220px;
}
QTableWidget#release-table {
    background: __SURFACE__;
    alternate-background-color: __SURFACE_SOFT__;
    gridline-color: transparent;
    border: 1px solid __BORDER_STRONG__;
    border-radius: 10px;
    selection-background-color: __PRIMARY__;
    selection-color: __ON_PRIMARY__;
    outline: 0;
}
QTableWidget#release-table::item {
    padding: 8px 9px;
    border: none;
    border-bottom: 1px solid __BORDER__;
    color: __TEXT_STRONG__;
}
QTableWidget#release-table::item:selected,
QTableWidget#release-table::item:selected:active,
QTableWidget#release-table::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 2px solid __PRIMARY__;
}

/* 通用列表/树/表选中兜底：跟主题软底，不要系统蓝/实心主色块 */
QListWidget::item:selected,
QListWidget::item:selected:active,
QListWidget::item:selected:!active,
QTreeWidget::item:selected,
QTreeWidget::item:selected:active,
QTreeWidget::item:selected:!active,
QTableWidget::item:selected,
QTableWidget::item:selected:active,
QTableWidget::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
}
QTableWidget#release-table QHeaderView::section,
QHeaderView#release-table-header::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
QTableWidget#release-table QHeaderView::section:hover,
QHeaderView#release-table-header::section:hover {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
}
QComboBox#table-combo, QComboBox#release-extra-system {
    min-height: 24px;
    max-height: 30px;
    padding: 3px 28px 3px 8px;
    border-radius: 8px;
    border: 1px solid __BORDER__;
    background: __SURFACE__;
}
QComboBox#table-combo::drop-down, QComboBox#release-extra-system::drop-down {
    width: 24px;
    border: none;
    border-left: 1px solid __BORDER__;
    background: __PRIMARY_SOFT__;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}
QComboBox#table-combo:hover, QComboBox#release-extra-system:hover {
    border-color: __PRIMARY__;
    background: __SURFACE__;
}
QDialog#confirm-dialog {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
}
QLabel#confirm-title {
    color: __TEXT_STRONG__;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.2px;
    background: transparent;
}
QFrame#confirm-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QLabel#confirm-message {
    color: __TEXT__;
    font-size: 13px;
    line-height: 1.5;
    background: transparent;
}
QPushButton#confirm-cancel {
    min-width: 88px;
    min-height: 32px;
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 7px 14px;
}
QDialog#confirm-dialog QPushButton#primary-btn,
QDialog#confirm-dialog QPushButton#ops-delete-custom,
QDialog#confirm-dialog QPushButton#btn-danger {
    min-height: 32px;
    border-radius: 10px;
    padding: 7px 14px;
}
/* 退出决策卡片样式已弃用（弹窗已精简为按钮行） */
QLabel#notice-badge-info,
QLabel#notice-badge-success,
QLabel#notice-badge-warning,
QLabel#notice-badge-error {
    border-radius: 16px;
    font-size: 18px;
    font-weight: 800;
    color: __SURFACE__;
}
QLabel#notice-badge-info { background: __PRIMARY__; }
QLabel#notice-badge-success { background: __SUCCESS__; }
QLabel#notice-badge-warning { background: __WARNING__; }
QLabel#notice-badge-error { background: __DANGER__; }
QMessageBox {
    background: __SIDEBAR_BG__;
}
QMessageBox QLabel {
    color: __TEXT__;
    min-width: 240px;
    font-size: 13px;
    background: transparent;
}
QMessageBox QPushButton {
    min-width: 96px;
    min-height: 32px;
    border-radius: 10px;
    padding: 7px 14px;
}

QDateEdit {
    background: __SURFACE__; color: __TEXT_STRONG__; border: 1px solid __BORDER__;
    border-radius: 10px; padding: 7px 38px 7px 11px;
    min-width: 150px; max-width: 160px; min-height: 18px; max-height: 34px;
    selection-background-color: __PRIMARY__; selection-color: __SURFACE__;
}
QDateEdit:hover { border-color: __PRIMARY__; background: __SURFACE__; }
QDateEdit:focus { border: 2px solid __PRIMARY__; padding: 6px 37px 6px 10px; }
QDateEdit::drop-down {
    subcontrol-origin: padding; subcontrol-position: top right;
    width: 32px; border: none; border-left: 1px solid __BORDER__;
    background: __PRIMARY_SOFT__; border-top-right-radius: 8px; border-bottom-right-radius: 8px;
}
QDateEdit::drop-down:hover { background: __PRIMARY_SOFT__; }
QDateEdit::down-arrow { image: url("__DROPDOWN_ARROW__"); width: 11px; height: 11px; }
QCalendarWidget { background: __SURFACE__; border: 1px solid __BORDER__; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: __PRIMARY__; }
QCalendarWidget QToolButton {
    color: __ON_PRIMARY__; background: transparent; border: none; border-radius: 8px;
    padding: 6px; font-weight: 700;
}
QCalendarWidget QToolButton:hover { background: __PRIMARY_SOFT__; color: __PRIMARY_ACTIVE__; }
QCalendarWidget QSpinBox {
    color: __ON_PRIMARY__; background: __PRIMARY_SOFT__;
    border: none; border-radius: 6px; padding: 4px;
}
QCalendarWidget QAbstractItemView:enabled {
    background: __SURFACE__; color: __TEXT_STRONG__; border: none; outline: 0;
    selection-background-color: __PRIMARY__; selection-color: __ON_PRIMARY__;
}
QGroupBox {
    background: __SURFACE__; color: __TEXT_MUTED__; font-weight: 700;
    border: 1px solid __BORDER__; border-radius: 12px; margin-top: 10px; padding: 16px 12px 12px;
}
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: __PRIMARY_ACTIVE__; }
/* —— 表格 / 树 全局基线（模块专属 #id 规则可继续覆盖）—— */
QTableWidget {
    background: __SURFACE__;
    alternate-background-color: __TABLE_ALT__;
    gridline-color: transparent;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    selection-background-color: __TABLE_SELECT__;
    selection-color: __TEXT_STRONG__;
    outline: 0;
}
QTableWidget::item {
    padding: 2px 8px;
    border: none;
    border-bottom: 1px solid __BORDER__;
    color: __TEXT__;
    background: __SURFACE__;
}
QTableWidget::item:alternate {
    background: __TABLE_ALT__;
}
QTableWidget::item:selected {
    background: __TABLE_SELECT__;
    color: __TEXT_STRONG__;
}
QTableWidget::item:hover {
    background: __PRIMARY_SOFT__;
}
QHeaderView {
    background: __SURFACE_SOFT__;
}
QTableWidget QHeaderView:horizontal,
QTreeWidget QHeaderView:horizontal {
    min-height: 24px;
    max-height: 26px;
}
QHeaderView::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
QHeaderView::section:hover {
    background: __PRIMARY_SOFT__;
    color: __TEXT_STRONG__;
}
QHeaderView::section:last {
    border-right: none;
}
QTreeWidget {
    background: __SURFACE__;
    alternate-background-color: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    outline: 0;
    show-decoration-selected: 1;
    padding: 3px;
}
QTreeWidget::item {
    min-height: 28px;
    padding: 4px 8px;
    color: __TEXT__;
    border-radius: 6px;
    border-bottom: 1px solid __SURFACE_SOFT__;
}
QTreeWidget::item:hover {
    background: __PRIMARY_SOFT__;
    color: __TEXT_STRONG__;
}
QTreeWidget::item:selected,
QTreeWidget::item:selected:active,
QTreeWidget::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 2px solid __PRIMARY__;
}
QTreeWidget::branch {
    background: transparent;
}
QTreeWidget::branch:hover,
QTreeWidget::branch:selected {
    background: transparent;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url("__BRANCH_CLOSED__");
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    border-image: none;
    image: url("__BRANCH_OPEN__");
}
QTabWidget::pane {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    top: -1px;
    padding: 4px;
}
QTabWidget#module-tabs::pane {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    margin-top: 1px;
    padding: 4px;
}
QTabBar {
    min-height: 24px;
    max-height: 28px;
    background: __SURFACE_SOFT__;
}
QTabBar::tab,
QTabWidget#module-tabs QTabBar::tab {
    background: __SURFACE__;
    color: __TEXT__;
    padding: 4px 12px;
    margin-right: 3px;
    min-width: 88px;
    min-height: 20px;
    max-height: 26px;
    border: 1px solid __BORDER_STRONG__;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    font-weight: 600;
    font-size: 12px;
}
QTabBar::tab:hover,
QTabWidget#module-tabs QTabBar::tab:hover {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY_SOFT__;
}
QTabBar::tab:selected,
QTabWidget#module-tabs QTabBar::tab:selected {
    color: __PRIMARY_ACTIVE__;
    font-weight: 700;
    background: __GLASS_BG__;
    border: 1px solid __GLASS_BORDER__;
    border-bottom: 2px solid __PRIMARY__;
}
QTabBar::scroller { width: 28px; }
QTabBar QToolButton {
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 6px;
    padding: 2px;
}
QScrollBar:vertical { background: transparent; width: 9px; }
QScrollBar::handle:vertical { background: __SCROLL_HANDLE__; border-radius: 4px; min-height: 25px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
#status_bar {
    background: __STATUS_BAR_BG__;
    color: __TEXT_MUTED__;
    border-top: 1px solid __BORDER__;
    min-height: 28px;
    padding-left: 10px;
    font-size: 12px;
}
#clock-label {
    color: __TEXT_MUTED__;
    padding-right: 10px;
    font-weight: 500;
    letter-spacing: 0.2px;
}
#page-title {
    color: __TEXT_STRONG__;
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.3px;
}
#page-subtitle {
    color: __TEXT_MUTED__;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
}
#offline-pill {
    color: __SUCCESS__;
    background: __SUCCESS_BG__;
    border: 1px solid __SUCCESS__;
    border-radius: 999px;
    padding: 5px 10px;
    font-weight: 750;
}
#tool-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
#tool-card:hover {
    border-color: __PRIMARY__;
    background: __SURFACE__;
}
#card-eyebrow { color: __PRIMARY_ACTIVE__; font-size: 10px; font-weight: 700; }
#card-title { color: __TEXT_STRONG__; font-size: 20px; font-weight: 700; }
#card-description { color: __TEXT_MUTED__; }
#shortcut-hint { color: __TEXT_MUTED__; background: __SURFACE__; border: 1px solid __BORDER__; border-radius: 12px; padding: 11px; }
#floating-toolbar {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 16px;
}
#floating-toolbar[compact="true"] {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QPushButton#floating-toggle {
    background: __SURFACE__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    font-size: 1px;
    padding: 0;
}
QPushButton#floating-toggle:hover {
    border-color: __PRIMARY__;
    background: __SURFACE_SOFT__;
}
#floating-title {
    color: __TEXT_STRONG__;
    font-size: 14px;
    font-weight: 700;
    padding: 0;
}
QPushButton#floating-icon-btn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
}
QPushButton#floating-icon-btn:hover {
    background: __PRIMARY_SOFT__;
}
QPushButton#floating-item {
    text-align: left;
    padding: 10px 12px;
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    color: __TEXT_STRONG__;
}
QPushButton#floating-item:hover {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
    border-color: __PRIMARY_SOFT__;
}
QPushButton#floating-home {
    background: transparent;
    color: __TEXT_MUTED__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 12px;
}
QPushButton#floating-home:hover {
    color: __PRIMARY_ACTIVE__;
    border-color: __PRIMARY__;
}
QListWidget#floating-learn-list {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}
QListWidget#floating-learn-list::item {
    padding: 4px 8px;
    border-radius: 8px;
    color: __TEXT_STRONG__;
}
QListWidget#floating-learn-list::item:selected {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
}
QPlainTextEdit#floating-learn-content {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 8px;
    font-size: 12px;
    color: __TEXT_STRONG__;
}
#sidebar-brand-icon {
    background: __PRIMARY_SOFT__;
    border-radius: 10px;
}

/* 首页任务卡 */
#dashboard-task-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
#dashboard-task-row {
    background: __SURFACE_SOFT__;
    border: 1px solid transparent;
    border-radius: 10px;
}
#dashboard-task-row:hover {
    border-color: __PRIMARY_SOFT__;
    background: __PRIMARY_SOFT__;
}
/* 今天上线 / 置顶：高亮提示 */
#dashboard-task-row-today {
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY__;
    border-left: 4px solid __PRIMARY_ACTIVE__;
    border-radius: 10px;
}
#dashboard-task-row-today:hover {
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY_ACTIVE__;
}
#dashboard-task-row-today #dashboard-task-title {
    color: __PRIMARY_ACTIVE__;
    font-weight: 700;
}
/* 已上线：降对比，与置顶高亮区分 */
#dashboard-task-row-done {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-left: 4px solid __SUCCESS__;
    border-radius: 10px;
}
#dashboard-task-row-done:hover {
    border-color: __SUCCESS__;
    background: __SURFACE__;
}
#dashboard-task-row-done #dashboard-task-title {
    color: __TEXT_MUTED__;
    font-weight: 600;
}
QLabel#status-pill-today {
    background: __PRIMARY__;
    color: __ON_PRIMARY__;
    border-radius: 8px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 11px;
}
QLabel#status-pill-done {
    background: __SUCCESS__;
    color: __ON_STATUS__;
    border-radius: 8px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 11px;
}
QLabel#dashboard-task-mark,
QLabel#dashboard-task-mark-done {
    font-size: 12px;
    font-weight: 700;
}
QLabel#dashboard-task-mark {
    color: __TEXT_MUTED__;
}
QLabel#dashboard-task-mark-done {
    color: __SUCCESS__;
}
#dashboard-section-header {
    background: transparent;
    border: none;
}
#dashboard-section-header[collapsible="true"] {
    background: __PRIMARY_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 0 4px;
}
#dashboard-section-title {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.6px;
}
#dashboard-section-header[collapsible="true"] #dashboard-section-title {
    color: __PRIMARY_ACTIVE__;
}
#dashboard-section-chevron {
    color: __PRIMARY_ACTIVE__;
    font-size: 14px;
    font-weight: 800;
    min-width: 16px;
}
#dashboard-task-identifier {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 6px;
    padding: 1px 5px;
    font-size: 11px;
    font-weight: 700;
}
#dashboard-task-title {
    color: __TEXT_STRONG__;
    font-size: 13px;
    font-weight: 600;
}
#dashboard-row-arrow {
    color: __TEXT_MUTED__;
    font-size: 16px;
    font-weight: 600;
}
#dashboard-local-status {
    color: __TEXT_MUTED__;
    font-size: 12px;
    padding: 4px 8px;
}
QMessageBox { background: __SURFACE__; }
QMessageBox QLabel { background: transparent; color: __TEXT_STRONG__; }
QProgressBar { background: __BORDER__; border: none; border-radius: 5px; text-align: center; }
QProgressBar::chunk { background: __PRIMARY__; border-radius: 5px; }

/* DOCX generation date · compact light calendar card */
QFrame#docx-date-card {
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 12px;
}
QLabel#docx-date-badge {
    background: __SURFACE_SOFT__;
    color: __PRIMARY__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 10px;
    font-weight: 800;
}
QDateEdit#docx-date {
    min-width: 150px;
    max-width: 160px;
    max-height: 28px;
}
QDateEdit#docx-date::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border: none;
    border-left: 1px solid __PRIMARY_SOFT__;
    background: __PRIMARY_SOFT__;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QPushButton#docx-date-today {
    background: __PRIMARY__;
    color: __SURFACE__;
    border: none;
    border-radius: 10px;
    padding: 8px 15px;
    font-weight: 700;
}
QPushButton#docx-date-today:hover { background: __PRIMARY_ACTIVE__; }
QCalendarWidget#docx-calendar { background: __SURFACE__; border: 1px solid __BORDER__; }
QCalendarWidget#docx-calendar QWidget#qt_calendar_navigationbar { background: __PRIMARY__; }
QCalendarWidget#docx-calendar QToolButton {
    color: __ON_PRIMARY__;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    font-weight: 700;
}
QCalendarWidget#docx-calendar QToolButton:hover { background: __PRIMARY_SOFT__; color: __PRIMARY_ACTIVE__; }
QCalendarWidget#docx-calendar QSpinBox {
    color: __ON_PRIMARY__;
    background: __PRIMARY_SOFT__;
    border: none;
    border-radius: 6px;
    padding: 4px;
}
QCalendarWidget#docx-calendar QAbstractItemView:enabled {
    background: __SURFACE__;
    color: __TEXT_STRONG__;
    border: none;
    selection-background-color: __PRIMARY__;
    selection-color: __ON_PRIMARY__;
    outline: 0;
}

/* JSON explorer */
QPushButton#json-tool-btn, QPushButton#json-icon-btn {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 8px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
}
QPushButton#json-tool-btn:hover, QPushButton#json-icon-btn:hover {
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY__;
}
QPushButton#json-icon-btn { min-width: 22px; max-width: 22px; padding: 6px 4px; }
QLineEdit#json-search { padding: 6px 9px; }
QLabel#json-search-status { color: __TEXT_MUTED__; background: transparent; min-width: 38px; }
QLabel#json-path-caption { color: __TEXT_MUTED__; background: transparent; font-size: 10px; }
QLineEdit#json-path {
    background: __SURFACE_SOFT__;
    color: __TEXT__;
    border: 1px solid __BORDER__;
    padding: 6px 9px;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 10px;
}
QPlainTextEdit#json-text {
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 11px;
    line-height: 1.35;
    background: __CODE_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
}
QPlainTextEdit#json-text:focus {
    border-color: __PRIMARY__;
    background: __CODE_BG__;
    color: __TEXT_STRONG__;
}
/* CodeGlance 右侧缩略条（绘制在自定义 widget 上，这里仅兜底） */
QWidget#code-glance {
    background: __CODE_BG__;
    border-left: 1px solid __BORDER__;
}
QWidget#fold-margin {
    background: __CODE_BG__;
    border-right: 1px solid __BORDER__;
}
QTreeWidget#json-tree {
    background: __SURFACE__;
    alternate-background-color: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
    selection-background-color: __TABLE_SELECT__;
    selection-color: __TEXT_STRONG__;
    outline: 0;
    show-decoration-selected: 1;
}
QTreeWidget#json-tree::item {
    min-height: 28px;
    padding: 5px 8px;
    border-bottom: 1px solid __SURFACE_SOFT__;
}
QTreeWidget#json-tree::item:hover { background: __PRIMARY_SOFT__; color: __TEXT_STRONG__; }
QTreeWidget#json-tree::item:selected,
QTreeWidget#json-tree::item:selected:active,
QTreeWidget#json-tree::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 2px solid __PRIMARY__;
}
QTreeWidget#json-tree QHeaderView::section,
QHeaderView#json-tree-header::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
QTreeWidget#json-tree QHeaderView::section:hover,
QHeaderView#json-tree-header::section:hover {
    background: __PRIMARY_SOFT__;
}

/* Linux operations command assistant */
QLineEdit#ops-search {
    background: __SURFACE__;
    border: 2px solid __PRIMARY_SOFT__;
    border-radius: 12px;
    padding: 9px 13px;
    font-size: 13px;
}
QLineEdit#ops-search:focus { border-color: __PRIMARY__; }
QLabel#ops-safety-note {
    color: __TEXT_MUTED__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 10px;
    padding: 9px 12px;
}
QFrame#ops-list-card, QFrame#ops-param-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QListWidget#ops-command-list,
QTreeWidget#ops-command-list {
    background: __SURFACE__;
    border: none;
    outline: 0;
    show-decoration-selected: 0;
}
QListWidget#ops-command-list::item,
QTreeWidget#ops-command-list::item {
    color: __TEXT_STRONG__;
    border-bottom: 1px solid __SURFACE_SOFT__;
    border-radius: 8px;
    padding: 9px 10px;
}
QListWidget#ops-command-list::item:hover,
QTreeWidget#ops-command-list::item:hover { background: __PRIMARY_SOFT__; }
QListWidget#ops-command-list::item:selected,
QListWidget#ops-command-list::item:selected:active,
QListWidget#ops-command-list::item:selected:!active,
QTreeWidget#ops-command-list::item:selected,
QTreeWidget#ops-command-list::item:selected:active,
QTreeWidget#ops-command-list::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
    border-left: 3px solid __PRIMARY__;
}
QTreeWidget#ops-command-list::branch:!has-children {
    image: none;
    border-image: none;
}
QLabel#ops-title { color: __TEXT_STRONG__; font-size: 16px; font-weight: 650; letter-spacing: -0.2px; }
QLabel#ops-description {
    color: __TEXT_MUTED__;
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    padding: 12px;
}
QLabel#ops-category-badge {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 10px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#ops-risk-badge {
    color: __SUCCESS__;
    background: __SUCCESS_BG__;
    border: 1px solid __SUCCESS_BORDER__;
    border-radius: 10px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#ops-risk-badge[risk="caution"] { color: __WARNING__; background: __WARNING_BG__; border-color: __WARNING_BORDER__; }
QLabel#ops-risk-badge[risk="danger"] { color: __DANGER__; background: __DANGER_BG__; border-color: __DANGER_BORDER__; }

QFrame#private-reminder-card {
  background: __SURFACE__;
  border: 1px solid __BORDER__;
  border-radius: 10px;
}
QLabel#daily-history-title {
    color: __TEXT_MUTED__;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.6px;
}
QLabel#private-sensitive-badge {
  color: __WARNING__;
  background: __WARNING_BG__;
  border: 1px solid __WARNING_BORDER__;
  border-radius: 10px;
  padding: 3px 8px;
  font-weight: 700;
}
QLabel#requirement-flags {
  color: __PRIMARY_ACTIVE__;
  background: __PRIMARY_SOFT__;
  border: 1px solid __BORDER__;
  border-radius: 10px;
  padding: 7px 10px;
}
QLabel#ops-warning {
    color: __WARNING__;
    background: __WARNING_BG__;
    border: 1px solid __WARNING_BORDER__;
    border-radius: 10px;
    padding: 10px;
    font-weight: 700;
}
QLabel#ops-output-guide {
    color: __TEXT__;
    background: __INFO_BG__;
    border: 1px solid __INFO_BORDER__;
    border-left: 4px solid __PRIMARY__;
    border-radius: 10px;
    padding: 11px 13px;
    line-height: 1.35;
}
QPlainTextEdit#ops-preview {
    background: __INPUT_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER_STRONG__;
    border-radius: 12px;
    padding: 10px;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
}
QPlainTextEdit#ops-preview:focus {
    border-color: __PRIMARY__;
    background: __SURFACE__;
    color: __TEXT_STRONG__;
}
QPlainTextEdit#private-content {
    background: __INPUT_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
}
QListWidget#ops-command-list::item {
    color: __TEXT__;
}
QLabel#ops-output-guide {
    color: __TEXT__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __BORDER__;
    border-left: 4px solid __PRIMARY__;
}
QFrame#ops-list-card, QFrame#ops-param-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
}
QLineEdit#ops-search {
    background: __SURFACE__;
    color: __TEXT_STRONG__;
    border: 2px solid __BORDER__;
}
QLineEdit#ops-search:focus { border-color: __PRIMARY__; }
/* ops-delete-custom 已并入上方 btn-danger 体系统一样式 */
QLabel#settings-value {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border-radius: 8px;
    padding: 5px 9px;
    min-width: 42px;
    font-weight: 700;
}
QSlider::groove:horizontal { height: 6px; background: __BORDER__; border-radius: 3px; }
QSlider::sub-page:horizontal { background: __PRIMARY__; border-radius: 3px; }
QSlider::handle:horizontal { width: 16px; margin: -5px 0; background: __ELEVATED_SURFACE__; border: 2px solid __PRIMARY__; border-radius: 8px; }

/* Tooltip / Menu / elevated dialog — night-safe */
QToolTip {
    background: __ELEVATED_SURFACE__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenu {
    background: __GLASS_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __GLASS_BORDER__;
    padding: 6px;
}
QMenu::item {
    padding: 7px 28px 7px 14px;
    border-radius: 6px;
    color: __TEXT__;
}
QMenu::item:selected {
    background: __PRIMARY_SOFT__;
    color: __PRIMARY_ACTIVE__;
}
QMenu::item:disabled { color: __DISABLED_TEXT__; }
QMenu::separator {
    height: 1px;
    background: __BORDER__;
    margin: 4px 8px;
}
QDialog {
    background: __GLASS_BG__;
    color: __TEXT_STRONG__;
    border: 1px solid __GLASS_BORDER__;
}
/* 实底高对比面：SQL/日志/终端/表格/密钥不使用玻璃 */
QPlainTextEdit#ai-prompt-edit,
QPlainTextEdit#ai-explain,
QWidget#SqlEditor,
QTableWidget,
QTreeWidget {
    background: __SURFACE__;
}
QToolButton#responsive-more-btn {
    background: __SURFACE__;
    color: __TEXT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 600;
}
QToolButton#responsive-more-btn:hover {
    background: __PRIMARY_SOFT__;
    border-color: __PRIMARY__;
    color: __PRIMARY_ACTIVE__;
}
QWidget[responsiveHidden="true"] { max-width: 0; max-height: 0; margin: 0; padding: 0; }
/* code surfaces */
QPlainTextEdit, QTextEdit {
    background: __CODE_BG__;
    color: __TEXT_STRONG__;
    selection-background-color: __PRIMARY_SOFT__;
    selection-color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
}
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: __PRIMARY__;
}

/* ── SSH 终端：控制台岛（深底亮字，与页面强对比；色相贴主题） ── */
QWidget#ssh-terminal-host {
    background: __TERM_BG__;
    border: 1px solid __TERM_BORDER__;
    border-radius: 12px;
}
QPlainTextEdit#ssh-terminal {
    background: __TERM_BG__;
    color: __TERM_FG__;
    border: none;
    border-radius: 12px;
    selection-background-color: __TERM_SEL__;
    selection-color: __TERM_FG__;
    padding: 10px 12px;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    font-size: 10.5pt;
}
QPlainTextEdit#ssh-terminal:focus {
    border: none;
    background: __TERM_BG__;
    color: __TERM_FG__;
}
QWidget#ssh-find-bar {
    background: __TERM_FIND_BG__;
    border-bottom: 1px solid __TERM_BORDER__;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    padding: 2px;
}
QLineEdit#ssh-find-edit {
    background: __TERM_BG__;
    color: __TERM_FG__;
    border: 1px solid __TERM_BORDER__;
    border-radius: 8px;
    padding: 4px 8px;
    selection-background-color: __TERM_SEL__;
}
QLineEdit#ssh-find-edit:focus {
    border-color: __TERM_SYS__;
}
QCheckBox#ssh-find-case {
    color: __TERM_MUTED__;
}
QPushButton#ssh-find-btn {
    background: __TERM_CHROME__;
    color: __TERM_FG__;
    border: 1px solid __TERM_BORDER__;
    border-radius: 8px;
    padding: 2px 10px;
    font-weight: 600;
}
QPushButton#ssh-find-btn:hover {
    background: __TERM_SEL__;
    border-color: __TERM_SYS__;
    color: __TERM_FG__;
}
QLabel#ssh-find-status {
    color: __TERM_SYS__;
    font-weight: 600;
    min-width: 48px;
}
QWidget#ops-left-panel {
    background: transparent;
}
QWidget#ops-right-panel {
    background: transparent;
}
QFrame#ops-term-card, QFrame#ops-result-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
/* 终端外壳：页面卡片色包住深色控制台，避免 sheet 割裂 */
QFrame#ops-term-shell {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
/* 标签栏贴页面；选中与控制台衔接 */
QTabWidget#ops-term-tabs::pane {
    border: 1px solid __TERM_BORDER__;
    border-radius: 10px;
    background: __TERM_BG__;
    top: -1px;
    padding: 0;
    margin: 0;
}
QTabWidget#ops-term-tabs QTabBar::tab {
    background: __SURFACE_SOFT__;
    color: __TEXT_MUTED__;
    border: 1px solid __BORDER__;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 3px 10px;
    margin-right: 2px;
    min-width: 48px;
    min-height: 18px;
    max-height: 24px;
    font-weight: 600;
    font-size: 12px;
}
QTabWidget#ops-term-tabs QTabBar::tab:selected {
    background: __TERM_BG__;
    color: __TERM_SYS__;
    border-color: __TERM_BORDER__;
}
QTabWidget#ops-term-tabs QTabBar::tab:hover:!selected {
    color: __TEXT_STRONG__;
    background: __PRIMARY_SOFT__;
}
/* 导出目标树：可横向滚动看全路径 */
QTreeWidget#ops-export-tree {
    border: 1px solid __BORDER__;
    border-radius: 8px;
    background: __SURFACE__;
    alternate-background-color: __TABLE_ALT__;
    color: __TEXT_STRONG__;
    outline: 0;
    show-decoration-selected: 0;
}
QTreeWidget#ops-export-tree::item {
    min-height: 26px;
    padding: 3px 6px;
}
QTreeWidget#ops-export-tree::item:selected,
QTreeWidget#ops-export-tree::item:selected:active,
QTreeWidget#ops-export-tree::item:selected:!active {
    background: __TABLE_SELECT__;
    color: __PRIMARY_ACTIVE__;
}
QTreeWidget#ops-export-tree QHeaderView::section {
    background: __SURFACE_SOFT__;
    color: __TEXT_STRONG__;
    border: none;
    border-right: 1px solid __BORDER__;
    border-bottom: 2px solid __PRIMARY__;
    padding: 3px 8px;
    min-height: 20px;
    font-weight: 700;
    font-size: 12px;
}
/* 圆滑弹框 */
QDialog#ops-dialog, QDialog#server-editor-dialog, QDialog#server-manage-dialog,
QDialog#cmd-history-dialog, QDialog#log-settings-dialog {
    background: __ELEVATED_SURFACE__;
    color: __TEXT_STRONG__;
    border: 1px solid __BORDER__;
    border-radius: 16px;
}
QDialog#ops-dialog QLabel#dialog-title,
QDialog#server-editor-dialog QLabel#dialog-title,
QDialog#server-manage-dialog QLabel#dialog-title,
QDialog#cmd-history-dialog QLabel#dialog-title {
    color: __TEXT_STRONG__;
    font-size: 16px;
    font-weight: 800;
}
QDialog#ops-dialog QFrame#dialog-card,
QDialog#server-editor-dialog QFrame#dialog-card,
QDialog#server-manage-dialog QFrame#dialog-card,
QDialog#cmd-history-dialog QFrame#dialog-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
}
QListWidget#ops-cmd-history-list, QTreeWidget#ops-cmd-history-list {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 12px;
    padding: 4px;
}
QListWidget#ops-cmd-history-list::item, QTreeWidget#ops-cmd-history-list::item {
    padding: 8px 10px;
    border-radius: 8px;
}
QListWidget#ops-cmd-history-list::item:selected, QTreeWidget#ops-cmd-history-list::item:selected {
    background: __PRIMARY_SOFT__;
    color: __TEXT_STRONG__;
}

/* 暗色/通用：滚动条更易辨认 */
QScrollBar:vertical {
    background: __SURFACE_SOFT__;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: __SCROLL_HANDLE__;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: __BORDER_STRONG__;
}
QScrollBar:horizontal {
    background: __SURFACE_SOFT__;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: __SCROLL_HANDLE__;
    border-radius: 5px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: __BORDER_STRONG__;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0; height: 0; background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Theme cards (Settings → Appearance) */
QFrame#theme-card {
    background: __SURFACE__;
    border: 1px solid __BORDER__;
    border-radius: 10px;
}
QFrame#theme-card:hover {
    border-color: __BORDER_STRONG__;
}
QFrame#theme-card[selected="true"] {
    border: 2px solid __PRIMARY__;
    background: __PRIMARY_SOFT__;
}
QFrame#theme-card-preview {
    border-radius: 6px;
    border: 1px solid __BORDER__;
}
QLabel#theme-card-name {
    color: __TEXT__;
    font-size: 11px;
    font-weight: 600;
}
QLabel#theme-current-badge {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __PRIMARY_SOFT__;
    border-radius: 8px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}
QFrame#theme-card {
    min-width: 148px;
    min-height: 96px;
}

/* ── Global workbench contract: density, focus, page chrome and status ── */
QMainWindow[uiDensity="compact"] QComboBox,
QMainWindow[uiDensity="compact"] QLineEdit,
QMainWindow[uiDensity="compact"] QDateEdit,
QMainWindow[uiDensity="compact"] QSpinBox {
    min-height: __CONTROL_HEIGHT_COMPACT__;
    max-height: __CONTROL_HEIGHT_COMPACT__;
}
QMainWindow[uiDensity="compact"] QTableWidget::item,
QMainWindow[uiDensity="compact"] QTreeWidget::item,
QMainWindow[uiDensity="compact"] QListWidget::item {
    min-height: __ROW_HEIGHT_COMPACT__;
}
QMainWindow[uiDensity="comfortable"] QComboBox,
QMainWindow[uiDensity="comfortable"] QLineEdit,
QMainWindow[uiDensity="comfortable"] QDateEdit,
QMainWindow[uiDensity="comfortable"] QSpinBox {
    min-height: __CONTROL_HEIGHT_COMFORTABLE__;
    max-height: __CONTROL_HEIGHT_COMFORTABLE__;
}
QMainWindow[uiDensity="comfortable"] QTableWidget::item,
QMainWindow[uiDensity="comfortable"] QTreeWidget::item,
QMainWindow[uiDensity="comfortable"] QListWidget::item {
    min-height: __ROW_HEIGHT_COMFORTABLE__;
}
/* 行内操作始终保持 28px：密度只影响常规控件，不得挤占列表展示空间。 */
QMainWindow[uiDensity="compact"] QPushButton[compactAction="true"],
QMainWindow[uiDensity="comfortable"] QPushButton[compactAction="true"] {
    min-height: 28px;
    max-height: 28px;
}
QPushButton:focus,
QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QDateEdit:focus,
QSpinBox:focus {
    border: 2px solid __FOCUS_RING__;
}
QLabel#page-context {
    color: __TEXT_MUTED__;
    font-size: 12px;
    padding-top: 1px;
}
QWidget#page-chrome {
    background: transparent;
}
QLabel#status-banner {
    color: __TEXT__;
    background: __STATUS_INFO_BG__;
    border: 1px solid __INFO_BORDER__;
    border-radius: 10px;
    padding: 8px 10px;
}
QLabel#status-banner[status="success"] {
    color: __SUCCESS__;
    background: __STATUS_SUCCESS_BG__;
    border-color: __SUCCESS_BORDER__;
}
QLabel#status-banner[status="warning"] {
    color: __WARNING__;
    background: __STATUS_WARNING_BG__;
    border-color: __WARNING_BORDER__;
}
QLabel#status-banner[status="danger"] {
    color: __DANGER__;
    background: __STATUS_DANGER_BG__;
    border-color: __DANGER_BORDER__;
}
QPushButton#danger-btn {
    color: __DANGER__;
    background: __SURFACE_SOFT__;
    border: 1px solid __DANGER__;
    border-radius: 8px;
    font-weight: 700;
}
QPushButton#danger-btn:hover {
    background: __STATUS_DANGER_BG__;
}

/* 测试任务点清单 */
QFrame#req-test-points-card {
    background: __SURFACE__;
    border: none;
}
QWidget#test-points-editor {
    background: transparent;
}
QLabel#test-points-hint {
    color: __PRIMARY_ACTIVE__;
    background: __PRIMARY_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 12px;
}
QLabel#test-points-empty {
    color: __TEXT_MUTED__;
    font-size: 12px;
    padding: 16px 8px;
}
QFrame#test-point-row {
    background: __SURFACE_SOFT__;
    border: 1px solid __BORDER__;
    border-radius: 8px;
}
QFrame#test-point-row:hover {
    border-color: __PRIMARY_SOFT__;
}
QFrame#test-point-row[done="true"] {
    background: __SURFACE__;
}
QLabel#test-point-text {
    color: __TEXT_STRONG__;
    font-size: 13px;
}
QFrame#test-point-row[done="true"] QLabel#test-point-text {
    color: __TEXT_MUTED__;
}
QDialog#test-points-dialog {
    background: __SURFACE__;
}
